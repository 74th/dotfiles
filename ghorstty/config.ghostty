# Config generated by Ghostty Config

command = /opt/homebrew/bin/bash
font-family = Moralerspace Argon JPDOC
font-family = Monaspace Argon Var
font-family = LigaInputMonoLight Nerd Font Mono
font-family = Monaco
font-family = Hiragino Sans W3
font-size = 12

# Guake的に使う機能はHammerspoonで実装するので、Ghostty側では無効化する
# keybind = global:cmd+shift+f3=toggle_quick_terminal
# quick-terminal-position = left
# quick-terminal-size = 1200px
# quick-terminal-screen = mouse
# quick-terminal-animation-duration = 0.08
# quick-terminal-autohide = false
# quick-terminal-space-behavior = move

# ANSI colors
palette = 0=#8F8F8F
palette = 1=#F82A5D
palette = 2=#98D800
palette = 3=#E7DC60
palette = 4=#5CCAEF
palette = 5=#F57F00
palette = 6=#A57FFF
palette = 7=#F1F1F1

palette = 8=#8F8F8F
palette = 9=#F82A5D
palette = 10=#98D800
palette = 11=#E7DC60
palette = 12=#5CCAEF
palette = 13=#F57F00
palette = 14=#A57FFF
palette = 15=#F1F1F1
background = #000000
foreground = #FFFFFF
