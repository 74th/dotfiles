#!/usr/bin/env -S uv run --no-project --script
# /// script
# requires-python = ">=3.12"
# dependencies = [
# ]
# ///
import argparse
import json
import pathlib
import shlex
import subprocess
import sys


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def detect_existing_sandbox_name(
    agent: str | None, include_subdirectory: bool
) -> tuple[str, bool]:
    """Return (sandbox name, whether cwd is a subdirectory of the workspace)."""
    cwd = pathlib.Path.cwd().resolve()

    out = subprocess.run(["sbx", "ls", "--json"], check=True, capture_output=True)
    sandbox_list = json.loads(out.stdout.decode("utf-8")).get("sandboxes", [])

    detected: dict[str, bool] = {}
    for sandbox in sandbox_list:
        for workspace in sandbox.get("workspaces", []):
            workspace_path = pathlib.Path(workspace).resolve()
            if workspace_path == cwd:
                detected[sandbox["name"]] = False
                break
            if include_subdirectory and workspace_path in cwd.parents:
                detected[sandbox["name"]] = True
                break

    if not detected:
        fail(f"Sandbox for workspace '{cwd}' does not exist.")

    names = list(detected)
    if agent is not None and len(names) > 1:
        agent_names = [name for name in names if agent in name]
        if len(agent_names) == 1:
            names = agent_names

    if len(names) > 1:
        fail(f"Multiple sandboxes detected for workspace '{cwd}': {names}")

    return names[0], detected[names[0]]


def build_run_command(agent: str, sandbox_name: str, is_subdirectory: bool) -> str:
    name = shlex.quote(sandbox_name)
    path = shlex.quote(str(pathlib.Path.cwd().resolve()))
    if agent == "codex":
        command = f"HERDR_AGENT=codex sbx run --name {name}"
        if is_subdirectory:
            command += f" -- --cd {path}"
        return command
    if agent == "claude":
        if is_subdirectory:
            return f"HERDR_AGENT=claude sbx exec -it -w {path} {name} claude"
        return f"HERDR_AGENT=claude sbx run --name {name}"
    fail(f"Unsupported agent for --output-run-command: '{agent}'")
    raise AssertionError


parser = argparse.ArgumentParser()
parser.add_argument("agent", nargs="?", help="agent name (codex/claude)")
parser.add_argument(
    "--include-subdirectory",
    action="store_true",
    help="also detect sandboxes whose workspace contains the current directory",
)
parser.add_argument(
    "--output-run-command",
    action="store_true",
    help="print the command to run the agent instead of the sandbox name",
)
args = parser.parse_args()

if args.output_run_command and args.agent is None:
    fail("--output-run-command requires an agent (codex/claude).")

sandbox_name, is_subdirectory = detect_existing_sandbox_name(
    args.agent, args.include_subdirectory
)

if args.output_run_command:
    print(build_run_command(args.agent, sandbox_name, is_subdirectory))
else:
    print(sandbox_name)
