#!/usr/bin/env -S uv run --no-project --script
# /// script
# requires-python = ">=3.12"
# dependencies = [
# ]
# ///
import json
import os
import pathlib
import subprocess
import sys


def detect_existing_sandbox_name(agent: str | None = None) -> str:
    workspace_path = pathlib.Path(os.getcwd()).resolve()

    out = subprocess.run(["sbx", "ls", "--json"], check=True, capture_output=True)
    sandbox_list = json.loads(out.stdout.decode("utf-8")).get("sandboxes", [])
    detected_sandboxes = [
        sandbox["name"]
        for sandbox in sandbox_list
        if any(
            pathlib.Path(workspace).resolve() == workspace_path
            for workspace in sandbox.get("workspaces", [])
        )
    ]

    if not detected_sandboxes:
        print(f"Sandbox for workspace '{workspace_path}' does not exist.")
        raise SystemExit(1)

    if agent is not None and len(detected_sandboxes) > 1:
        agent_sandboxes = [
            sandbox for sandbox in detected_sandboxes if agent in sandbox
        ]
        if len(agent_sandboxes) == 1:
            return agent_sandboxes[0]

    if len(detected_sandboxes) > 1:
        print(
            f"Multiple sandboxes detected for workspace '{workspace_path}': {detected_sandboxes}"
        )
        raise SystemExit(1)

    return detected_sandboxes[0]


agent = sys.argv[1] if len(sys.argv) > 1 else None
detected_sandbox = detect_existing_sandbox_name(agent)

print(detected_sandbox)
