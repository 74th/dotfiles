#!/usr/bin/env -S uv run --script
from pathlib import Path
import subprocess

p = Path("~/ghq/github.com/74th/mycheatsheets/").expanduser()

print(f"cd {p} && git pull")
subprocess.run(
    ["git", "pull"],
    check=True,
    capture_output=True,
    cwd=p,
)

code = Path("~/ghq/github.com/74th/dotfiles/bin/c").expanduser()
print(f"{code} {p}")

subprocess.run(
    [code, f"{p}/sheets"],
    check=True,
    capture_output=True,
)
